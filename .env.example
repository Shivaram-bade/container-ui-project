# Docker Compose ports
VITEL_FRONTEND_PORT=3000
VITEL_BACKEND_PORT=8000
VITEL_REGISTRY_PORT=5000

# Persistent Redis and registry data
VITEL_DATA_ROOT=/opt/vitel

# SQLite database file on the host
VITEL_DATABASE_PATH=./backend/db.sqlite3

# Host folders exposed read-only for Dockerfile and Compose browsing.
# The source and container target are identical so absolute paths keep working.
VITEL_HOST_WORKSPACE_ROOT=/home
VITEL_HOST_ROOT_HOME=/root

# Optional public addresses. Set these when using NAT, DNS, custom ports, or a reverse proxy.
VITEL_REGISTRY_PUSH_HOST=localhost:5000
VITEL_REGISTRY_PULL_HOST=
VITEL_CONTROL_SERVER_URL=
VITEL_CONTROL_SERVER_WS_URL=
